{
  "entities": {
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized administrator identity document",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "displayName": { "type": "string", "maxLength": 120 },
        "grantedBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private customer profile, saved addresses, and wishlist",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 32 },
        "defaultState": { "type": "string", "maxLength": 64 },
        "defaultCity": { "type": "string", "maxLength": 80 },
        "defaultAddress": { "type": "string", "maxLength": 300 },
        "savedAddresses": { "type": "array", "description": "Up to 5 saved Nigerian delivery addresses" },
        "wishlist": { "type": "array", "description": "Up to 50 saved product IDs" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "createdAt", "updatedAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Electronics or home appliance catalog product",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 180 },
        "slug": { "type": "string", "minLength": 2, "maxLength": 200 },
        "brand": { "type": "string", "minLength": 1, "maxLength": 80 },
        "category": { "type": "string", "minLength": 1, "maxLength": 80 },
        "subcategory": { "type": "string", "maxLength": 80 },
        "description": { "type": "string", "minLength": 5, "maxLength": 4000 },
        "priceNgn": { "type": "number" },
        "discountPercent": { "type": "number" },
        "stock": { "type": "number" },
        "lowStockThreshold": { "type": "number" },
        "images": { "type": "array", "description": "1 to 8 product image URLs" },
        "specs": { "type": "array", "description": "Up to 25 specification key/value entries" },
        "variants": { "type": "array", "description": "Up to 12 product variants" },
        "featured": { "type": "boolean" },
        "bestSeller": { "type": "boolean" },
        "newArrival": { "type": "boolean" },
        "specialOffer": { "type": "boolean" },
        "installmentEligible": { "type": "boolean" },
        "bnplEligible": { "type": "boolean" },
        "minInstallmentNgn": { "type": "number" },
        "allowedDurationsWeeks": { "type": "array" },
        "ratingAvg": { "type": "number" },
        "reviewCount": { "type": "number" },
        "active": { "type": "boolean" },
        "approvalStatus": { "type": "string", "enum": ["Pending Admin Approval", "Published", "Unpublished"] },
        "needsConfirmation": { "type": "boolean" },
        "confirmationNote": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "brand", "category", "priceNgn", "stock", "images", "installmentEligible", "bnplEligible", "active", "createdAt", "updatedAt"]
    },
    "Category": {
      "title": "Category",
      "description": "Product category with subcategories",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 80 },
        "slug": { "type": "string", "minLength": 2, "maxLength": 100 },
        "subcategories": { "type": "array" },
        "sortOrder": { "type": "number" },
        "active": { "type": "boolean" }
      },
      "required": ["id", "name", "slug", "subcategories", "sortOrder", "active"]
    },
    "Brand": {
      "title": "Brand",
      "description": "Electronics manufacturer brand",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "slug": { "type": "string", "minLength": 1, "maxLength": 100 },
        "featured": { "type": "boolean" },
        "active": { "type": "boolean" }
      },
      "required": ["id", "name", "slug", "featured", "active"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Promotional discount coupon",
      "type": "object",
      "properties": {
        "code": { "type": "string", "minLength": 3, "maxLength": 32, "pattern": "^[A-Z0-9_\\-]+$" },
        "discountType": { "type": "string", "enum": ["percent", "fixed"] },
        "discountValue": { "type": "number" },
        "minOrderNgn": { "type": "number" },
        "applicableProductIds": { "type": "array" },
        "maxUses": { "type": "number" },
        "usedCount": { "type": "number" },
        "expiresAt": { "type": "string", "maxLength": 64 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "discountType", "discountValue", "minOrderNgn", "active", "createdAt"]
    },
    "ShippingZone": {
      "title": "ShippingZone",
      "description": "Nigerian state shipping fee and estimated delivery rule",
      "type": "object",
      "properties": {
        "state": { "type": "string", "minLength": 2, "maxLength": 64 },
        "region": { "type": "string", "minLength": 2, "maxLength": 64 },
        "feeNgn": { "type": "number" },
        "estimatedDays": { "type": "string", "minLength": 1, "maxLength": 64 },
        "freeShippingThresholdNgn": { "type": "number" },
        "active": { "type": "boolean" }
      },
      "required": ["state", "region", "feeNgn", "estimatedDays", "active"]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Global storefront and payment rules configuration",
      "type": "object",
      "properties": {
        "minInstallmentNgn": { "type": "number" },
        "defaultInstallmentDurationsWeeks": { "type": "array" },
        "paySmallSmallEnabled": { "type": "boolean" },
        "bnplEnabled": { "type": "boolean" },
        "paystackEnabled": { "type": "boolean" },
        "bankTransferEnabled": { "type": "boolean" },
        "bankName": { "type": "string", "maxLength": 120 },
        "bankAccountNumber": { "type": "string", "maxLength": 20 },
        "bankAccountName": { "type": "string", "maxLength": 120 },
        "freeDeliveryThresholdNgn": { "type": "number" },
        "supportPhone": { "type": "string", "maxLength": 32 },
        "supportEmail": { "type": "string", "maxLength": 160 },
        "supportWhatsapp": { "type": "string", "maxLength": 32 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["minInstallmentNgn", "defaultInstallmentDurationsWeeks", "paySmallSmallEnabled", "bnplEnabled", "paystackEnabled", "updatedAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order with payment and delivery tracking",
      "type": "object",
      "properties": {
        "orderNumber": { "type": "string", "minLength": 4, "maxLength": 40 },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "customerName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "customerEmail": { "type": "string", "format": "email", "maxLength": 200 },
        "customerPhone": { "type": "string", "minLength": 5, "maxLength": 32 },
        "paymentMethod": { "type": "string", "enum": ["buy_now", "bank_transfer", "pay_small_small", "credibly_bnpl"] },
        "paymentStatus": { "type": "string", "enum": ["pending", "verified", "partial", "paid", "failed"] },
        "orderStatus": { "type": "string", "enum": ["Order Received", "Payment Confirmed", "Processing", "Dispatched", "Out for Delivery", "Delivered", "Cancelled"] },
        "items": { "type": "array" },
        "subtotalNgn": { "type": "number" },
        "discountNgn": { "type": "number" },
        "couponCode": { "type": "string", "maxLength": 32 },
        "shippingFeeNgn": { "type": "number" },
        "totalNgn": { "type": "number" },
        "shippingState": { "type": "string", "minLength": 2, "maxLength": 64 },
        "shippingCity": { "type": "string", "minLength": 1, "maxLength": 80 },
        "shippingAddress": { "type": "string", "minLength": 5, "maxLength": 300 },
        "estimatedDelivery": { "type": "string", "maxLength": 80 },
        "paymentReference": { "type": "string", "maxLength": 128 },
        "receiptNumber": { "type": "string", "maxLength": 64 },
        "trackingHistory": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orderNumber", "userId", "customerName", "customerEmail", "customerPhone", "paymentMethod", "paymentStatus", "orderStatus", "items", "subtotalNgn", "discountNgn", "shippingFeeNgn", "totalNgn", "shippingState", "shippingCity", "shippingAddress", "createdAt", "updatedAt"]
    },
    "SavingsPlan": {
      "title": "SavingsPlan",
      "description": "Pay Small Small installment savings plan",
      "type": "object",
      "properties": {
        "planNumber": { "type": "string", "minLength": 4, "maxLength": 40 },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "customerEmail": { "type": "string", "format": "email", "maxLength": 200 },
        "customerName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "customerPhone": { "type": "string", "minLength": 5, "maxLength": 32 },
        "productId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "productName": { "type": "string", "minLength": 2, "maxLength": 180 },
        "productImage": { "type": "string", "maxLength": 600 },
        "variantName": { "type": "string", "maxLength": 100 },
        "totalPriceNgn": { "type": "number" },
        "amountPaidNgn": { "type": "number" },
        "outstandingNgn": { "type": "number" },
        "minInstallmentNgn": { "type": "number" },
        "durationWeeks": { "type": "number" },
        "installmentFrequency": { "type": "string", "enum": ["weekly", "biweekly", "monthly", "flexible"] },
        "status": { "type": "string", "enum": ["active", "completed", "released", "cancelled"] },
        "releaseApproved": { "type": "boolean" },
        "shippingState": { "type": "string", "minLength": 2, "maxLength": 64 },
        "shippingCity": { "type": "string", "minLength": 1, "maxLength": 80 },
        "shippingAddress": { "type": "string", "minLength": 5, "maxLength": 300 },
        "shippingFeeNgn": { "type": "number" },
        "nextReminderAt": { "type": "string", "maxLength": 64 },
        "paymentHistory": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["planNumber", "userId", "customerEmail", "customerName", "customerPhone", "productId", "productName", "totalPriceNgn", "amountPaidNgn", "outstandingNgn", "minInstallmentNgn", "durationWeeks", "status", "releaseApproved", "shippingState", "shippingCity", "shippingAddress", "createdAt", "updatedAt"]
    },
    "PaymentRecord": {
      "title": "PaymentRecord",
      "description": "Immutable payment transaction record keyed by unique reference",
      "type": "object",
      "properties": {
        "reference": { "type": "string", "minLength": 4, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "orderId": { "type": "string", "maxLength": 128 },
        "savingsPlanId": { "type": "string", "maxLength": 128 },
        "paymentMethod": { "type": "string", "maxLength": 40 },
        "amountNgn": { "type": "number" },
        "currency": { "type": "string", "enum": ["NGN"] },
        "status": { "type": "string", "enum": ["pending", "verified", "failed"] },
        "gateway": { "type": "string", "enum": ["paystack", "bank_transfer", "credibly"] },
        "gatewayResponse": { "type": "string", "maxLength": 300 },
        "verificationProof": { "type": "string", "maxLength": 256 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["reference", "userId", "paymentMethod", "amountNgn", "currency", "status", "gateway", "createdAt"]
    },
    "BnplApplication": {
      "title": "BnplApplication",
      "description": "Credibly Buy Now Pay Later financing application",
      "type": "object",
      "properties": {
        "applicationNumber": { "type": "string", "minLength": 4, "maxLength": 40 },
        "crediblyReference": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "customerName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "customerEmail": { "type": "string", "format": "email", "maxLength": 200 },
        "customerPhone": { "type": "string", "minLength": 5, "maxLength": 32 },
        "bvnLast4": { "type": "string", "maxLength": 4 },
        "monthlyIncomeNgn": { "type": "number" },
        "employmentStatus": { "type": "string", "maxLength": 64 },
        "orderId": { "type": "string", "maxLength": 128 },
        "items": { "type": "array" },
        "totalNgn": { "type": "number" },
        "tenureMonths": { "type": "number" },
        "status": { "type": "string", "enum": ["awaiting_credentials", "submitted", "under_review", "approved", "declined", "completed"] },
        "providerMessage": { "type": "string", "maxLength": 500 },
        "isLiveCredibly": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["applicationNumber", "userId", "customerName", "customerEmail", "customerPhone", "totalNgn", "tenureMonths", "status", "isLiveCredibly", "createdAt", "updatedAt"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer product review",
      "type": "object",
      "properties": {
        "productId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "rating": { "type": "number" },
        "title": { "type": "string", "minLength": 2, "maxLength": 140 },
        "comment": { "type": "string", "minLength": 5, "maxLength": 1500 },
        "verifiedPurchase": { "type": "boolean" },
        "approved": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "userId", "userName", "rating", "title", "comment", "approved", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Customer or admin notification event",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "type": { "type": "string", "enum": ["payment", "order", "savings", "bnpl", "low_stock", "admin_alert"] },
        "title": { "type": "string", "minLength": 2, "maxLength": 160 },
        "message": { "type": "string", "minLength": 2, "maxLength": 800 },
        "channel": { "type": "string", "enum": ["in_app", "email", "whatsapp", "sms"] },
        "deliveryStatus": { "type": "string", "enum": ["sent", "queued", "provider_unconfigured"] },
        "relatedId": { "type": "string", "maxLength": 128 },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "type", "title", "message", "channel", "deliveryStatus", "read", "createdAt"]
    }
  },
  "firestore": {
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Admin role registry"
    },
    "/users/{uid}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private customer profiles"
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Storefront electronics and home appliances catalog"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Product categories and subcategories"
    },
    "/brands/{brandId}": {
      "schema": { "$ref": "#/entities/Brand" },
      "description": "Electronics brands"
    },
    "/coupons/{couponCode}": {
      "schema": { "$ref": "#/entities/Coupon" },
      "description": "Promotional coupon codes keyed by uppercase code"
    },
    "/shipping_zones/{zoneId}": {
      "schema": { "$ref": "#/entities/ShippingZone" },
      "description": "Nigerian state shipping rates and ETAs"
    },
    "/store_settings/{settingId}": {
      "schema": { "$ref": "#/entities/StoreSettings" },
      "description": "Global storefront payment and support settings"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders"
    },
    "/savings_plans/{planId}": {
      "schema": { "$ref": "#/entities/SavingsPlan" },
      "description": "Pay Small Small installment savings plans"
    },
    "/payments/{paymentRef}": {
      "schema": { "$ref": "#/entities/PaymentRecord" },
      "description": "Unique transaction ledger keyed by payment reference"
    },
    "/bnpl_applications/{applicationId}": {
      "schema": { "$ref": "#/entities/BnplApplication" },
      "description": "Credibly BNPL financing applications"
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Product reviews"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "Automated notifications for customers and admins"
    }
  }
}
