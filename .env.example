# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# Paystack Payment Gateway (Nigeria)
PAYSTACK_SECRET_KEY=
VITE_PAYSTACK_PUBLIC_KEY=

# Credibly Buy Now Pay Later (Official Merchant API)
CREDIBLY_API_KEY=
CREDIBLY_MERCHANT_ID=
CREDIBLY_BASE_URL=https://api.credibly.ng/v1

# Cloudinary Image Storage & Signed Uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
VITE_CLOUDINARY_CLOUD_NAME=

# Automated Notifications (Email / SMS / WhatsApp)
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=
TERMII_API_KEY=
TERMII_SENDER_ID=LuxeApp
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
